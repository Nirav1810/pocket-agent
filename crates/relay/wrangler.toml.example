# Pocket Agent relay — Cloudflare Workers config template.
#
# Do not edit this file for your own deployment. `cargo xtask relay-setup`
# copies it to `wrangler.toml` (git-ignored) and fills in your values.
# Secrets are NOT configured here; they are set with `wrangler secret put`:
#   ANTHROPIC_API_KEY   your Anthropic API key
#   PAIRING_CODE        the code your phone uses to pair (generated by xtask)

name = "__WORKER_NAME__"
main = "build/index.js"
compatibility_date = "2026-10-15"
# Free plan: 10 ms CPU per request. The relay uses well under that.

[build]
command = "cargo install -q worker-build@0.8.7 --locked && worker-build --release"

[[d1_databases]]
binding = "DB"
database_name = "__DATABASE_NAME__"
database_id = "__DATABASE_ID__"
migrations_dir = "migrations"

# Workers Logs: lets you see per-request CPU time in the dashboard.
# The relay only logs route name, status and duration — never content.
[observability]
enabled = true

[vars]
# Comma-separated models the relay will forward.
MODEL_ALLOWLIST = "claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5"
# anthropic-beta values the relay will forward.
BETA_ALLOWLIST = "server-side-fallback-2026-07-01"
# Requests asking for more output tokens are clamped to this.
MAX_TOKENS_CAP = "16000"
# Soft spending caps in USD (estimates from PRICES). "0" disables a cap.
# Also set a hard limit in the Anthropic Console.
DAILY_USD_CAP = "2"
MONTHLY_USD_CAP = "20"
# Wrong pairing codes allowed before pairing locks (rotate the code to unlock).
PAIRING_MAX_FAILURES = "10"
# USD per 1M tokens, used only for the usage screen and soft caps.
PRICES = '''
{
  "claude-haiku-5-5":  {"input": 0.10, "output": 0.50, "cache_read": 0.01, "cache_write": 0.125},
  "claude-sonnet-5-5": {"input": 2.00, "output": 10.00, "cache_read": 0.20, "cache_write": 2.50},
  "claude-opus-5-5":   {"input": 4.00, "output": 20.00, "cache_read": 0.20, "cache_write": 5.00}
}
'''

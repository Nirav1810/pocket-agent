# Pocket Agent local settings for desktop tools (the agent-core REPL).
#
#   cp .env.example .env      # then fill in .env
#
# `.env` is git-ignored: never commit real keys. Real environment variables
# override values here. Leave a value empty to leave it unset.

# --- Direct mode: your Anthropic API key (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Relay mode: your own relay (cargo xtask relay-setup prints these) ---
POCKET_AGENT_RELAY_URL=
# First run: set the pairing code; the REPL pairs and prints a device token.
POCKET_AGENT_PAIRING_CODE=
# Then put the printed token here and clear the pairing code.
POCKET_AGENT_DEVICE_TOKEN=

# --- Options ---
# relay | direct (only needed when both are configured; default: relay)
POCKET_AGENT_MODE=
# Reply language, e.g. en-US, hi-IN, es-ES
POCKET_AGENT_LOCALE=en-US
# 1 = approve confirmation prompts automatically
POCKET_AGENT_AUTO_CONFIRM=

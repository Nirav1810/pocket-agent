# =====================================================================
#  Pocket Agent - local settings for the desktop REPL
#  This file is git-ignored. Never commit it or paste it anywhere.
#  Run:  cargo run -p pocket-agent-core --example repl
# =====================================================================

# ---------------------------------------------------------------------
# 1. Which way to reach Claude
#    direct = straight to api.anthropic.com with the key below
#             (what you have now, nothing else needed)
#    relay  = through your own Cloudflare relay (section 3, optional)
# ---------------------------------------------------------------------
POCKET_AGENT_MODE=direct

# ---------------------------------------------------------------------
# 2. Direct mode: your Anthropic API key
#    Create/revoke at https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# 3. Relay mode (OPTIONAL - leave empty until you deploy a relay)
#    a) run:  cargo xtask relay-setup
#       it prints a "Relay URL" and a "Pairing code"
#    b) paste them below, set POCKET_AGENT_MODE=relay, run the REPL once
#    c) the REPL prints "POCKET_AGENT_DEVICE_TOKEN=pa_dt_..."
#       paste that below and clear the pairing code
# ---------------------------------------------------------------------
POCKET_AGENT_RELAY_URL=
POCKET_AGENT_PAIRING_CODE=
POCKET_AGENT_DEVICE_TOKEN=

# ---------------------------------------------------------------------
# 4. Spending limits enforced by the agent itself (US dollars, estimated)
#    When reached, the agent refuses new requests until the next
#    UTC day/month. 0 = no limit. Also set a hard limit in the Console:
#    https://console.anthropic.com/settings/limits
# ---------------------------------------------------------------------
POCKET_AGENT_DAILY_LIMIT_USD=1.00
POCKET_AGENT_MONTHLY_LIMIT_USD=10.00

# ---------------------------------------------------------------------
# 5. Other options
# ---------------------------------------------------------------------
# Language the agent replies in: en-US, en-IN, hi-IN, es-ES, ...
POCKET_AGENT_LOCALE=en-US
# 1 = auto-approve confirmations (calls, messages). Leave empty = ask.
POCKET_AGENT_AUTO_CONFIRM=
